<div class="container py-5 text-center">
  <h1 class="h5 mb-2">Đang chuyển sang cổng thanh toán...</h1>
  <p class="text-muted">Nếu trang không tự chuyển, hãy bấm nút bên dưới.</p>
  <form id="gatewayForm" method="post" action="<%= form.action %>">
    <% Object.entries(form.fields).forEach(([name, value]) => { %>
      <input type="hidden" name="<%= name %>" value="<%= value %>">
    <% }) %>
    <button type="submit" class="btn btn-danger">Tiếp tục thanh toán</button>
  </form>
</div>
<script src="/js/autoSubmit.js"></script>