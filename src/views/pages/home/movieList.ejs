<section class="gc-section pt-0">
  <h1 class="gc-section__title mb-3"><%= heading %></h1>

  <% if (movies.length) { %>
    <p class="text-muted small mb-3"><%= movies.length %> phim</p>
    <div class="gc-grid">
      <% movies.forEach((movie) => { %><%- include('../../partials/movieCard', { movie }) %><% }) %>
    </div>
  <% } else { %>
    <div class="text-center text-muted py-5">
      <i class="bi bi-film fs-1 d-block mb-2" aria-hidden="true"></i>
      <p class="mb-3"><%= emptyText %></p>
      <a href="/" class="btn btn-sm btn-outline-secondary">Về trang chủ</a>
    </div>
  <% } %>
</section>