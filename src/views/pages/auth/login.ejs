<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <h2 class="mb-3">Đăng nhập</h2>

    <% if (errors.length) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(function (msg) { %><li><%= msg %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/login" novalidate>
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input type="email" class="form-control" id="email" name="email" value="<%= values.email || '' %>" required placeholder="Nhập Email"/>
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Mật khẩu</label>
        <input type="password" class="form-control" id="password" name="password" required placeholder="Nhập mật khẩu"/>
      </div>
      <button class="btn btn-primary w-100">Đăng nhập</button>
    </form>
    <p class="mt-2 text-center"><a href="/forgot-password">Quên mật khẩu?</a></p>
    <p class="mt-3 text-center">Bạn chưa có tài khoản? <a href="/register">Đăng ký</a></p>
  </div>
</div>