<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <h2 class="mb-3">Đặt mật khẩu mới</h2>

    <% if (errors.length) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(function (msg) { %><li><%= msg %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/reset-password/<%= token %>" novalidate>
      <div class="mb-3">
        <label class="form-label" for="new_password">Mật khẩu mới</label>
        <input type="password" class="form-control" id="new_password" name="new_password" required autofocus />
        <div class="form-text">Tối thiểu 8 ký tự, gồm chữ và số.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="confirm_new_password">Nhập lại mật khẩu mới</label>
        <input type="password" class="form-control" id="confirm_new_password" name="confirm_new_password" required />
      </div>
      <button class="btn btn-primary w-100">Đặt lại mật khẩu</button>
    </form>
  </div>
</div>