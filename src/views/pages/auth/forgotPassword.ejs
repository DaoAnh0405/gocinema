<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <h2 class="mb-3">Quên mật khẩu</h2>
    <p class="text-muted">Nhập email đã đăng ký, chúng tôi sẽ gửi liên kết để bạn đặt lại mật khẩu.</p>

    <% if (errors.length) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(function (msg) { %><li><%= msg %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/forgot-password" novalidate>
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input type="email" class="form-control" id="email" name="email" value="<%= values.email || '' %>" required autofocus />
      </div>
      <button class="btn btn-primary w-100">Gửi liên kết đặt lại</button>
    </form>

    <p class="mt-3 text-center"><a href="/login">Quay lại đăng nhập</a></p>
  </div>
</div>