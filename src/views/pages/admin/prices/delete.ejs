<form method="post" action="/admin/prices/<%= editingId %>/delete<%= pageQuery %>" data-price-form>
  <input type="hidden" name="_csrf" value="<%= priceCsrf %>">
  <p>Bạn có chắc chắn muốn xóa mức giá này?</p>
  <p><%= values.seat_type_name %> · <%= values.screen_format %> · <%= dayLabels[values.day_type] %><br><%= fmt.money(values.price) %></p>
  <div class="price-dialog__actions">
    <%- include('../../../components/prices/button', { href: listUrl, text: 'Hủy bỏ' }) %>
    <%- include('../../../components/prices/button', { type: 'submit', variant: 'primary', text: 'Xóa' }) %>
  </div>
</form>
