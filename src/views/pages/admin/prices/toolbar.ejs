<form class="price-filters" method="get" action="/admin/prices" aria-label="Lọc giá vé" data-price-filters>
  <div class="price-filter-select">
  <select name="seat" aria-label="Lọc theo loại ghế">
    <option value="">Loại ghế</option>
    <% seatTypes.forEach((seat) => { %><option value="<%= seat.seat_type_id %>" <%= filters.seat === String(seat.seat_type_id) ? 'selected' : '' %>><%= seat.seat_type_name %></option><% }) %>
  </select>
  <i class="bi bi-chevron-down" aria-hidden="true"></i>
  </div>
  <div class="price-filter-select">
  <select name="format" aria-label="Lọc theo định dạng">
    <option value="">Định dạng</option>
    <% formats.forEach((format) => { %><option value="<%= format %>" <%= filters.format === format ? 'selected' : '' %>><%= format %></option><% }) %>
  </select>
  <i class="bi bi-chevron-down" aria-hidden="true"></i>
  </div>
  <div class="price-filter-select">
  <select name="day" aria-label="Lọc theo loại ngày">
    <option value="">Loại ngày</option>
    <% Object.entries(dayLabels).forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.day === value ? 'selected' : '' %>><%= label %></option><% }) %>
  </select>
  <i class="bi bi-chevron-down" aria-hidden="true"></i>
  </div>
</form>
<%- include('../../../components/admin/button', { href: '/admin/prices/new' + pageQuery, variant: 'primary', text: 'Thêm mức giá', icon: 'plus' }) %>