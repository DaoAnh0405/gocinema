<link rel="stylesheet" href="/css/admin-catalog.css">
<%
  const statusLabels = { NOW_SHOWING: 'Đang chiếu', COMING_SOON: 'Sắp chiếu', ENDED: 'Ngừng chiếu' };
  const currentPage = Math.max(1, Number(pagination.page) || 1);
  const totalPages = Math.max(1, Number(pagination.totalPages) || 1);
  const total = Number(pagination.total) || 0;
  const pageSize = Number(pagination.pageSize) || 7;
  const firstItem = total && movies.length ? (currentPage - 1) * pageSize + 1 : 0;
  const lastItem = total && movies.length ? Math.min(total, firstItem + movies.length - 1) : 0;
  const pageUrl = (page) => {
    const params = new URLSearchParams();
    for (const key of ['q', 'status', 'genre']) {
      if (filters[key] !== undefined && filters[key] !== null && String(filters[key])) params.set(key, String(filters[key]));
    }
    params.set('page', String(page));
    return '/admin/movies?' + params.toString();
  };
  const pageNumbers = [...new Set([1, totalPages, currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2])]
    .filter((page) => page >= 1 && page <= totalPages).sort((a, b) => a - b);
%>
<section class="gc-catalog" aria-label="Quản lý phim">
  <div class="gc-catalog__toolbar">
    <form class="gc-catalog__filters" method="get" action="/admin/movies" role="search">
      <div class="gc-catalog__search">
        <label class="visually-hidden" for="movie-search">Tìm kiếm theo tên phim</label>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="form-control" id="movie-search" name="q" value="<%= filters.q || '' %>" maxlength="200" placeholder="Tìm kiếm theo tên phim...">
      </div>
      <div>
        <label class="visually-hidden" for="movie-status-filter">Trạng thái</label>
        <select class="form-select" id="movie-status-filter" name="status">
          <option value="">Tất cả trạng thái</option>
          <% statuses.forEach((status) => { %>
            <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= statusLabels[status] || status %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="visually-hidden" for="movie-genre-filter">Thể loại</label>
        <select class="form-select" id="movie-genre-filter" name="genre">
          <option value="">Tất cả thể loại</option>
          <% genres.forEach((genre) => { %>
            <option value="<%= genre.genre_id %>" <%= String(filters.genre) === String(genre.genre_id) ? 'selected' : '' %>><%= genre.genre_name %></option>
          <% }) %>
        </select>
      </div>
      <button class="btn gc-catalog__filter-button" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> Lọc</button>
    </form>
    <a class="btn gc-catalog__primary" href="/admin/movies/new"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm phim mới</a>
  </div>

  <div class="gc-catalog__table-panel">
    <div class="gc-catalog__table-scroll">
      <table class="table gc-catalog__table gc-catalog__movie-table">
        <caption class="visually-hidden">Danh sách phim</caption>
        <thead><tr><th scope="col">Poster</th><th scope="col">Tên phim</th><th scope="col">Thể loại</th><th scope="col">Thời lượng</th><th scope="col">Khởi chiếu</th><th scope="col">Tuổi</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
        <tbody>
          <% if (!movies.length) { %>
            <tr><td colspan="8" class="gc-catalog__empty"><i class="bi bi-film" aria-hidden="true"></i><p>Không tìm thấy phim phù hợp.</p><a href="/admin/movies">Xem tất cả phim</a></td></tr>
          <% } %>
          <% movies.forEach((movie) => { %>
            <tr>
              <td>
                <% if (movie.poster_url) { %>
                  <img class="gc-catalog__poster-thumb" src="<%= movie.poster_url %>" alt="Poster <%= movie.title %>" loading="lazy" width="48" height="66">
                <% } else { %>
                  <span class="gc-catalog__poster-thumb gc-catalog__poster-empty" role="img" aria-label="Chưa có poster"><i class="bi bi-image" aria-hidden="true"></i></span>
                <% } %>
              </td>
              <th scope="row" class="gc-catalog__movie-title"><a href="/admin/movies/<%= movie.movie_id %>/edit"><%= movie.title %></a></th>
              <td class="gc-catalog__genres-cell"><%= movie.genres || '—' %></td>
              <td class="text-nowrap"><%= movie.duration %> phút</td>
              <td class="text-nowrap"><%= movie.release_date ? fmt.date(movie.release_date) : '—' %></td>
              <td><span class="gc-catalog__age"><%= movie.age_rating || '—' %></span></td>
              <td><span class="gc-catalog__status <%= movie.status === 'NOW_SHOWING' ? 'gc-catalog__status--showing' : movie.status === 'COMING_SOON' ? 'gc-catalog__status--soon' : 'gc-catalog__status--ended' %>"><%= statusLabels[movie.status] || movie.status %></span></td>
              <td>
                <div class="gc-catalog__actions">
                  <a class="gc-catalog__icon-button" href="/admin/movies/<%= movie.movie_id %>/edit" aria-label="Sửa phim <%= movie.title %>" title="Chỉnh sửa"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                  <form method="post" action="/admin/movies/<%= movie.movie_id %>/delete" data-confirm-delete data-confirm-message="Bạn có chắc muốn xóa phim “<%= movie.title %>”? Hành động này không thể hoàn tác.">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="gc-catalog__icon-button gc-catalog__icon-button--danger" type="submit" aria-label="Xóa phim <%= movie.title %>" title="Xóa phim"><i class="bi bi-trash" aria-hidden="true"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <footer class="gc-catalog__table-footer">
      <p>Hiển thị <strong><%= firstItem %>–<%= lastItem %></strong> trong <strong><%= total %></strong> phim</p>
      <nav aria-label="Phân trang phim">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.hasPrevious ? '' : 'disabled' %>">
            <% if (pagination.hasPrevious) { %><a class="page-link" href="<%= pageUrl(currentPage - 1) %>" aria-label="Trang trước" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i></a><% } else { %><span class="page-link" aria-disabled="true" aria-label="Trang trước"><i class="bi bi-chevron-left" aria-hidden="true"></i></span><% } %>
          </li>
          <% pageNumbers.forEach((page, index) => { %>
            <% if (index && page - pageNumbers[index - 1] > 1) { %><li class="page-item disabled"><span class="page-link" aria-hidden="true">…</span></li><% } %>
            <li class="page-item <%= page === currentPage ? 'active' : '' %>"><% if (page === currentPage) { %><span class="page-link" aria-current="page"><%= page %></span><% } else { %><a class="page-link" href="<%= pageUrl(page) %>" aria-label="Trang <%= page %>"><%= page %></a><% } %></li>
          <% }) %>
          <li class="page-item <%= pagination.hasNext ? '' : 'disabled' %>">
            <% if (pagination.hasNext) { %><a class="page-link" href="<%= pageUrl(currentPage + 1) %>" aria-label="Trang sau" rel="next"><i class="bi bi-chevron-right" aria-hidden="true"></i></a><% } else { %><span class="page-link" aria-disabled="true" aria-label="Trang sau"><i class="bi bi-chevron-right" aria-hidden="true"></i></span><% } %>
          </li>
        </ul>
      </nav>
    </footer>
  </div>
  <dialog class="gc-catalog__dialog" data-delete-dialog aria-labelledby="catalog-dialog-title" aria-describedby="catalog-dialog-message">
    <h2 id="catalog-dialog-title">Xác nhận xóa</h2>
    <p id="catalog-dialog-message" data-dialog-message>Bạn có chắc muốn xóa phim này?</p>
    <div class="gc-catalog__dialog-actions"><button class="btn gc-catalog__secondary" type="button" data-dialog-cancel autofocus>Hủy</button><button class="btn gc-catalog__primary" type="button" data-dialog-confirm>Xóa</button></div>
  </dialog>
</section>
<script src="/js/admin-catalog.js"></script>
