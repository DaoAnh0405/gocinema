
<div class="price-pagination">

  <p>
    <%= pagination.start %> -
    <%= pagination.end %> /
    <%= pagination.total %>
    <%= locals.paginationLabel || 'mức giá' %>
  </p>

  <% if (pagination.totalPages > 1) { %>

    <nav aria-label="Phân trang">

      <ul>

        <li>
          <% if (pagination.page > 1) { %>

            <a href="<%= pageUrl(pagination.page - 1) %>"
               rel="prev"
               aria-label="Trang trước">

              <i class="bi bi-caret-left-fill"></i>

            </a>

          <% } else { %>

            <span aria-disabled="true">
              <i class="bi bi-caret-left-fill"></i>
            </span>

          <% } %>
        </li>

        <%
          const pageNumbers = [
            ...new Set([
              1,
              pagination.page - 1,
              pagination.page,
              pagination.page + 1,
              pagination.totalPages
            ])
          ]
          .filter(number =>
            number >= 1 &&
            number <= pagination.totalPages
          )
          .sort((a, b) => a - b);

          pageNumbers.forEach((number, index) => {
        %>

          <% if (
            index > 0 &&
            number - pageNumbers[index - 1] > 1
          ) { %>

            <li>
              <span class="price-pagination__ellipsis">…</span>
            </li>

          <% } %>

          <li>

            <% if (number === pagination.page) { %>

              <span aria-current="page">
                <%= number %>
              </span>

            <% } else { %>

              <a href="<%= pageUrl(number) %>">
                <%= number %>
              </a>

            <% } %>

          </li>

        <% }) %>

        <li>

          <% if (pagination.page < pagination.totalPages) { %>

            <a href="<%= pageUrl(pagination.page + 1) %>"
               rel="next"
               aria-label="Trang sau">

              <i class="bi bi-caret-right-fill"></i>

            </a>

          <% } else { %>

            <span aria-disabled="true">
              <i class="bi bi-caret-right-fill"></i>
            </span>

          <% } %>

        </li>

      </ul>

    </nav>

  <% } %>

</div>