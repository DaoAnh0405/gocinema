
<header class="gc-header">
  <div class="container d-flex align-items-center gap-3 py-2">

    <!-- nav bar tạm -->
    <nav class="gc-nav" aria-label="Điều hướng chính">
      <div class="container">
        <ul class="nav">
          <li class="nav-item">
            <a class="nav-link gc-nav-buy" href="/booking">Mua vé</a>
          </li>
          <li class="nav-item dropdown">
            <button type="button" class="nav-link" data-bs-toggle="dropdown" aria-expanded="false">
              Phim <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu">
              <li>
                <a class="dropdown-item<%= currentPath === '/movies/now-showing' ? ' active' : '' %>"
                   href="/movies/now-showing"<%- currentPath === '/movies/now-showing' ? ' aria-current="page"' : '' %>>
                  Phim đang chiếu
                </a>
              </li>
              <li>
                <a class="dropdown-item<%= currentPath === '/movies/coming-soon' ? ' active' : '' %>"
                   href="/movies/coming-soon"<%- currentPath === '/movies/coming-soon' ? ' aria-current="page"' : '' %>>
                  Phim sắp chiếu
                </a>
              </li>
            </ul>
          </li>
          <li class="nav-item">
            <button type="button" class="nav-link" data-bs-toggle="modal" data-bs-target="#cinemaModal">Rạp</button>
          </li>
          <!-- <li class="nav-item">
            <a class="nav-link" href="/promotions">Ưu đãi</a>
          </li> -->
        </ul>
      </div>
    </nav>

    <!-- logo -->
    <a href="/" class="gc-logo">GoCinema</a>

    <!-- tìm kiếm -->
    <form class="gc-search flex-grow-1 d-none d-md-block"
      action="/movies" method="get" role="search">
      <div class="input-group input-group-sm">
        <input type="search" name="q" class="form-control"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          placeholder="Tìm phim..."
          maxlength="100" required autocomplete="off"
          aria-label="Tìm phim">
        <button class="btn btn-outline-secondary" type="submit"
          aria-label="Tìm">
          <i class="bi bi-search"></i>
        </button>
      </div>
    </form>

    <!-- tài khoản -->
    <div class="ms-auto">
      <% if (currentUser) { %>
        <div class="dropdown">
          <button class="btn btn-sm btn-light dropdown-toggle"
                  data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle"></i>
            <span class="d-none d-sm-inline">
              <%= currentUser.fullName || currentUser.email %>
            </span>
          </button>

          <ul class="dropdown-menu dropdown-menu-end">
            <% if (currentUser.role === ROLE.ADMIN) { %>
              <li>
                <a class="dropdown-item px-3" href="/admin">
                  Trang quản trị
                </a>
              </li>
            <% } else if (currentUser.role === ROLE.STAFF) { %>
              <li>
                <a class="dropdown-item px-3" href="/staff">
                  Trang nhân viên
                </a>
              </li>
            <% } else if (currentUser.role === ROLE.CUSTOMER) { %>
              <li>
                <a class="dropdown-item px-3" href="/profile">
                  Tài khoản
                </a>
              </li>
              <li>
                <a class="dropdown-item px-3" href="/orders">
                  Lịch sử
                </a>
              </li>
              <li>
                <a class="dropdown-item px-3" href="/profile/password">
                  Đổi mật khẩu
                </a>
              </li>
            <% } %>

            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="post" class="px-3">
                <button class="btn btn-link text-danger p-0" type="submit">
                  Đăng xuất
                </button>
              </form>
            </li>
          </ul>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-sm btn-light">Đăng nhập</a>
        <!-- <a href="/register"
           class="btn btn-sm btn-outline-danger d-none d-sm-inline-block">
          Đăng ký
        </a> -->
      <% } %>
    </div>

  </div>
</header>