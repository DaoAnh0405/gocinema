<div class="modal fade gc-cinema-modal" id="cinemaModal" tabindex="-1"
     aria-labelledby="cinemaModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header border-0 pb-2">
        <h2 class="modal-title" id="cinemaModalTitle">Rạp chiếu</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <div class="gc-cinema-city">
        <select id="cinemaCity" class="form-select" aria-label="Chọn khu vực" hidden></select>
      </div>
      <div class="modal-body p-0">
        <p id="cinemaNote" class="text-muted small px-3 py-3 mb-0">Đang tải danh sách rạp...</p>
        <ul id="cinemaList" class="gc-cinema-list"></ul>
      </div>
    </div>
  </div>
</div>