<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GoCinema - Quản lý Đồ ăn</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/food-admin.css">
</head>
<body class="bg-[#F5F5F5] text-gray-800 flex h-screen overflow-hidden">

  <!-- SIDEBAR -->
  <aside class="w-60 bg-[#D1D1D1] flex flex-col shrink-0 border-r border-gray-300 select-none overflow-y-auto">
    <div class="p-5 pb-3">
      <h1 class="text-2xl font-bold text-[#D91A1A] leading-none">GoCinema</h1>
      <p class="text-xs text-gray-600 mt-1">Quản trị</p>
    </div>

    <nav class="mt-2 text-sm font-medium text-gray-800">
      <a href="#" class="block px-5 py-2.5 hover:bg-gray-300 transition">Tổng quan</a>

      <div class="px-5 pt-4 pb-1 text-xs font-semibold text-gray-600 uppercase tracking-wider">Danh mục</div>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Phim</a>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Thể loại</a>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Rạp & phòng chiếu</a>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Suất chiếu</a>

      <div class="px-5 pt-4 pb-1 text-xs font-semibold text-gray-600 uppercase tracking-wider">Bán hàng</div>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Giá vé</a>
      <a href="/admin/foods" class="block px-5 py-2.5 bg-[#3B363F] text-white font-semibold">Đồ ăn</a>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Khuyến mãi</a>

      <div class="px-5 pt-4 pb-1 text-xs font-semibold text-gray-600 uppercase tracking-wider">Hệ thống</div>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Tài khoản</a>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Phân quyền</a>
      <a href="#" class="block px-5 py-2 hover:bg-gray-300 transition">Thống kê</a>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="flex-1 flex flex-col overflow-y-auto">
    <header class="flex justify-between items-center px-8 py-5 bg-[#F5F5F5]">
      <h2 class="text-2xl font-normal text-gray-900">Quản lý Đồ ăn</h2>
      <button class="flex items-center gap-2 bg-[#E0E0E0] hover:bg-gray-300 text-gray-800 px-3.5 py-1.5 rounded-md text-sm font-medium transition">
        <span class="bg-purple-200 text-purple-700 w-5 h-5 rounded flex items-center justify-center text-xs">
          <i class="fa-regular fa-user"></i>
        </span>
        <span>admin@gocinema.vn</span>
        <i class="fa-solid fa-caret-down text-xs ml-1"></i>
      </button>
    </header>

    <div class="px-8 pb-8 flex-1">
      <!-- Toolbar -->
      <div class="bg-[#DCDCDC] p-3.5 rounded-lg flex flex-wrap justify-between items-center gap-3 mb-6">
        <div class="flex flex-wrap items-center gap-3">
          <div class="relative">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
            <input type="text" id="searchInput" oninput="fetchFoods()" placeholder="Tìm kiếm..." class="bg-white border border-gray-300 text-gray-700 text-sm rounded-md pl-8 pr-3 py-1.5 w-48 focus:outline-none">
          </div>

          <select id="filterStatus" onchange="fetchFoods()" class="bg-white border border-gray-300 text-gray-700 text-sm rounded-md px-3 py-1.5 focus:outline-none">
            <option value="">Trạng thái</option>
            <option value="Đang bán">Đang bán</option>
            <option value="Ngừng bán">Ngừng bán</option>
          </select>
        </div>

        <button onclick="openAddModal()" class="bg-[#D90404] hover:bg-red-700 text-white text-sm font-medium px-4 py-2 rounded-md flex items-center gap-2 transition shadow-sm">
          <i class="fa-solid fa-plus"></i>
          <span>Thêm món</span>
        </button>
      </div>

      <!-- Cards Grid -->
      <div id="foodGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5"></div>
    </div>
  </main>

  <!-- MODAL: THÊM MÓN MỚI -->
  <div id="addModal" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50">
    <div class="bg-[#DCDCDC] w-full max-w-md rounded-xl p-6 shadow-xl">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Thêm món mới</h3>
      <form id="addForm" onsubmit="handleAddSubmit(event)" class="space-y-3.5">
        <div>
          <label for="addImageInput" class="w-full h-36 bg-white rounded-lg border border-gray-300 flex items-center justify-center cursor-pointer hover:bg-gray-50 transition overflow-hidden">
            <img id="addImagePreview" src="" alt="Preview" class="hidden w-full h-full object-cover">
            <div id="addImagePlaceholder" class="flex items-center gap-2 text-gray-700">
              <i class="fa-solid fa-arrow-up-from-bracket text-lg"></i>
              <span class="text-sm font-medium">Ảnh</span>
            </div>
          </label>
          <input type="file" id="addImageInput" name="image" accept="image/*" onchange="previewImage(event, 'addImagePreview', 'addImagePlaceholder')" class="hidden">
        </div>

        <div>
          <label class="block text-sm text-gray-800 mb-1">Tên</label>
          <input type="text" name="name" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none">
        </div>

        <div>
          <label class="block text-sm text-gray-800 mb-1">Mô tả</label>
          <input type="text" name="description" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none">
        </div>

        <div>
          <label class="block text-sm text-gray-800 mb-1">Giá bán (VND)</label>
          <input type="number" name="price" required min="0" step="1000" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none">
        </div>

        <div class="flex justify-end gap-3 pt-3">
          <button type="button" onclick="closeModal('addModal')" class="bg-[#F2F2F2] hover:bg-gray-200 text-gray-800 text-sm font-medium px-6 py-2 rounded-md border border-gray-300">Hủy bỏ</button>
          <button type="submit" class="bg-[#D90404] hover:bg-red-700 text-white text-sm font-medium px-8 py-2 rounded-md">Lưu</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: SỬA MÓN -->
  <div id="editModal" class="fixed inset-0 bg-black/60 hidden items-center justify-center z-50">
    <div class="bg-[#DCDCDC] w-full max-w-md rounded-xl p-6 shadow-xl">
      <h3 id="editModalTitle" class="text-lg font-medium text-gray-900 mb-4">Sửa món: Tên món</h3>
      <form id="editForm" onsubmit="handleEditSubmit(event)" class="space-y-3.5">
        <input type="hidden" id="editId">

        <div>
          <label class="block text-sm text-gray-800 mb-1">Tên</label>
          <input type="text" id="editName" name="name" required class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none">
        </div>

        <div>
          <label class="block text-sm text-gray-800 mb-1">Mô tả</label>
          <input type="text" id="editDesc" name="description" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none">
        </div>

        <div>
          <label class="block text-sm text-gray-800 mb-1">Giá bán (VND)</label>
          <input type="number" id="editPrice" name="price" required min="0" step="1000" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none">
        </div>

        <div>
          <label class="block text-sm text-gray-800 mb-1">Trạng thái</label>
          <select id="editStatus" name="status" class="w-full bg-white border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none">
            <option value="Đang bán">Đang bán</option>
            <option value="Ngừng bán">Ngừng bán</option>
          </select>
        </div>

        <div class="flex justify-end gap-3 pt-3">
          <button type="button" onclick="closeModal('editModal')" class="bg-[#F2F2F2] hover:bg-gray-200 text-gray-800 text-sm font-medium px-6 py-2 rounded-md border border-gray-300">Hủy bỏ</button>
          <button type="submit" class="bg-[#D90404] hover:bg-red-700 text-white text-sm font-medium px-8 py-2 rounded-md">Lưu</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/food-admin.js"></script>
</body>
</html>