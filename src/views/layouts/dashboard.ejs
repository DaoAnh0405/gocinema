
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= typeof title !== 'undefined' && title ? title + ' · ' : '' %>
    GoCinema <%= panelName %>
  </title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- css chung Admin / Staff -->
  <link rel="stylesheet" href="/css/dashboard.css">
  <!-- css riêng của từng chức năng -->
  <% (locals.pageStyles || []).forEach((href) => { %>
    <link rel="stylesheet" href="<%= href %>">
  <% }) %>
  <%- style %>
</head>

<body class="gc-dash gc-dash--<%= panel %>">
  <div class="gc-shell">
    <!--css sidebar dùng chung -->
    <%- include('../partials/sidebar') %>
    <div class="gc-main<%= locals.moduleClass ? ' price-main price-app ' + moduleClass : '' %>">
      <!-- topbar dùng chung -->
      <%- include('../partials/topbar') %>
      <!-- nội dung từng chức năng -->
      <main class="gc-content<%= locals.moduleClass ? ' price-content' : '' %>">
        <%- include('../partials/flash') %>
        <%- body %>
      </main>
    </div>
    <div class="gc-backdrop" data-sidebar-toggle></div>
  </div>
  <!-- js chung -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/dashboard.js"></script>
  <!-- js riêng của từng chức năng -->
  <% (locals.pageScripts || []).forEach((src) => { %>
    <script src="<%= src %>" defer></script>
  <% }) %>
  <%- script %>

  <% if (locals.adminModule) { %>
    <link rel="stylesheet" href="/css/adminManagement.css">
  <% } %>
</body>
</html>