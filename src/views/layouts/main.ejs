<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>GoCinema: <%= typeof title !== 'undefined' && title ? title : '' %></title>
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/main.css">
  <%- style %>
</head>
<body class="gc-site">
  <%- include('../partials/publicHeader') %>

  <main class="gc-site__main">
    <% if (typeof fullWidth !== 'undefined' && fullWidth) { %>
      <div class="container mt-3"><%- include('../partials/flash') %></div>
      <%- body %>
    <% } else { %>
      <div class="container py-4">
        <%- include('../partials/flash') %>
        <%- body %>
      </div>
    <% } %>
  </main>

  <%- include('../partials/publicFooter') %>
  <%- include('../partials/cinemaModal') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/cinemaModal.js"></script>
  <%- script %>
</body>
</html>