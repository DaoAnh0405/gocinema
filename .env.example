# app
# chạy lệnh này tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
PORT=3000
SESSION_SECRET=chuỗi ngẫu nhiên
APP_URL=http://localhost:3000

# db (Docker map cổng 3307)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=nhập mk db vào đây có ký tự đb thì để vào ""
DB_NAME=gocinema

# đặt vé
SEAT_HOLD_MINUTES=10

# dưới này chưa cần quan tâm
# thanh toán: mock (vnpay) 
PAYMENT_PROVIDER=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# mail (gmail SMTP, dùng App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=service.gocinema@gmail.com
MAIL_PASS=
MAIL_FROM="GoCinema <service.gocinema@gmail.com>"